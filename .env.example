# Copy to .env and replace only the providers you use. Never commit .env.
GEMINI_API_KEY_1=replace-me
GEMINI_API_KEY_2=replace-me

# Logical provider order. Numbered Gemini slots are expanded automatically.
LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github
GLC_PORT=8111

# S16 channel bridge. Use the same private value in S16_CHANNEL_BRIDGE_TOKEN.
S16_BASE_URL=http://127.0.0.1:8113
GLC_S16_BRIDGE_TOKEN=replace-with-a-long-random-local-token
GLC_S16_TIMEOUT=180
